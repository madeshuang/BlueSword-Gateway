# 复制为 .env，修改后需重启服务；配置步骤见 README 和对应联调指南

# 两种联调共用：AI 配置，选择 openai 或 deepseek，填写对应密钥和模型
BOOTH_AI_PROVIDER=openai
# OpenAI 官方或 GPT 中转；密钥只保存在本机，超时时间单位为毫秒
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_MS=20000
# DeepSeek 使用固定的官方地址，无需填写 URL
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=20000

# 两种机器人模式共用：语音默认启用。修改后重启；false 可关闭语音，文字聊天照常使用
BOOTH_SPEECH_ENABLED=true
# 选择 ali 或 tencent，填写对应服务的凭据；模型由程序指定
BOOTH_SPEECH_PROVIDER=ali
# ali 使用 qwen-audio-3.1-asr-flash-message，密钥请从阿里百炼控制台获取
DASHSCOPE_API_KEY=
# 可选：使用北京地域的专属工作空间地址时填写；使用默认地址时留空
DASHSCOPE_WORKSPACE_ID=
# tencent 使用 Hy-ASR-3.0-preview，以下三项凭据均为必填
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 两种联调共用：从网关建立取物任务起计算，等待时间超过此值后，会显示等待提醒（毫秒）
BOOTH_TASK_REMINDER_MS=120000

# 本机人工联调：默认加载 config/booth-catalog.example.json 中的现场 10 种物品
# 只影响 start-local.cmd / manual:gateway，不改变真实模式的 BOOTH_CATALOG_PATH
# 如需另用一份练习清单，可在此填写相对于项目根目录的 JSON 路径
BOOTH_MANUAL_CATALOG_PATH=

# 真实机器人联调:按真实机器人联调指南填写以下配置;人工入口的启动脚本会自动设置以下各项
# 其他电脑或设备需要访问网关时，改为 0.0.0.0
BOOTH_HOST=127.0.0.1
PORT=4100
BOOTH_ROBOT_MODE=http
ROBOT_DISPATCH_URL=
# 下发任务后，等待机器人回复是否接单的最长时间（毫秒）
ROBOT_TIMEOUT_MS=8000
BOOTH_CATALOG_PATH=config/booth-catalog.example.json
BOOTH_CATALOG_CONFIRMED=false
BOOTH_DB_PATH=.data/booth.sqlite
BOOTH_OPERATOR_TOKEN=
