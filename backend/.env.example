# 复制为 backend/.env 后填写；真实环境变量优先，也会读取根目录 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
BLUESWORD_SPEECH_MODEL=qwen-audio-3.1-asr-flash-message
BLUESWORD_TTS_MODEL=qwen3-tts-flash
BLUESWORD_TTS_VOICE=Cherry
BLUESWORD_OPERATOR_TOKEN=
BLUESWORD_ROBOT_MODE=mock
# 以下仅在 lanjian_http 模式填写；请核对目录 robotItem/name 与机器人支持的名称或编码。
BLUESWORD_ROBOT_DISPATCH_URL=
# VLM 模式留空时读取项目内 config/booth-catalog.example.json；也可指定自己的绝对路径。
# 替换 JSON 后，在任务结束并核对完毕后重启后端生效，无需重建前端。
BLUESWORD_CATALOG_PATH=
BLUESWORD_ROBOT_PROTOCOL=vlm
BLUESWORD_SPLIT_SKILLS=false
