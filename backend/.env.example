# 从项目根目录复制到 backend/.env 后填写，不要覆盖已有配置或提交真实密钥。
# 配置填写在 backend/.env；进程环境中的同名变量优先，修改后重启后端。
# 下列超时单位均为秒。默认 mock 不连接真实机器人。

# 大模型：当前默认使用 DeepSeek；不填 Key 时使用规则路由。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 自定义地址必须兼容当前 Chat Completions、工具调用及 reasoning_effort 请求。
BLUESWORD_LLM_BASE_URL=https://api.deepseek.com
BLUESWORD_LLM_TIMEOUT=90
# 思考强度可选 low / high / max；后者用于技能结果返回后的复盘。
BLUESWORD_LLM_REASONING_EFFORT=high
BLUESWORD_LLM_REVIEW_EFFORT=max

# 阿里百炼：北京地域 Key，需开通对应识别和播报模型。
# 不填 Key 时无法使用云端识别和播报，仍可打字。
DASHSCOPE_API_KEY=
# 可选：识别使用的北京地域专属工作空间；默认地址留空。
DASHSCOPE_WORKSPACE_ID=
BLUESWORD_SPEECH_MODEL=qwen-audio-3.1-asr-flash-message
BLUESWORD_TTS_MODEL=qwen3-tts-flash
BLUESWORD_TTS_VOICE=Cherry

# 机器人：mock 为内部模拟；现场改为 lanjian_http 并填写完整发单地址。
BLUESWORD_ROBOT_MODE=mock
BLUESWORD_ROBOT_PROTOCOL=vlm
BLUESWORD_ROBOT_DISPATCH_URL=
# 普通 mock 与 VLM 共用目录，留空时读取项目内 config/booth-catalog.example.json；自定义建议绝对路径。
# 替换 JSON 后，在任务结束并核对完毕后重启后端，无需重建前端。
BLUESWORD_CATALOG_PATH=
# 现场保持 false：一次确认下发完整取送任务，不拆分取货、卸货。
BLUESWORD_SPLIT_SKILLS=false
# 用户确认、机器人接单/健康请求、接单后最终结果的等待上限。
BLUESWORD_CONFIRM_TIMEOUT=180
BLUESWORD_ROBOT_TIMEOUT=8
# 0 表示不限制机器人执行总时长，仍等待最终回报。
BLUESWORD_REMOTE_TASK_TIMEOUT=0

# 数据与现场操作：数据库路径相对于后端进程工作目录，部署时建议绝对路径。
# mock / gdk_mock 自动在文件名添加对应模式后缀，与现场库存分开。
BLUESWORD_DB_PATH=data/tasks.sqlite3
# 工作人员恢复接单、补货使用；留空时这些操作不可用。不是网页访问 token。
BLUESWORD_OPERATOR_TOKEN=

# 可选网页访问控制：设置后还需按 README 配置前端 VITE_AGENT_WS 并重新构建。
BLUESWORD_API_TOKEN=
# JSON 数组；跨源页面按实际来源填写。同源 WebSocket 也允许。
BLUESWORD_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 网页显示识别照片；关闭仅影响展示，不改变机器人协议
BLUESWORD_SHOW_CAMERA=true
# 工作人员通信记录保留天数
BLUESWORD_PROTOCOL_RETENTION_DAYS=30
BLUESWORD_MOCK_DELAY=1
