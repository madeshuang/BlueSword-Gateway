{
  "name": "bluesword-gateway",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently --names api,web \"pnpm dev:api\" \"pnpm --filter @bluesword/web dev\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/booth/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/booth/index.ts",
    "dev:demo": "concurrently --names api,robot,web \"node --env-file-if-exists=.env --import tsx apps/api/src/booth/index.ts --simulator\" \"node --import tsx scripts/robot-simulator.ts\" \"pnpm --filter @bluesword/web dev\"",
    "dev:robot": "node --import tsx scripts/robot-simulator.ts",
    "build": "pnpm typecheck && pnpm --filter @bluesword/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run apps/api/src/booth/booth.test.ts apps/api/src/booth/selection-change.test.ts apps/api/src/booth/integration.test.ts apps/api/src/booth/inventory.test.ts scripts/verify-ai.test.ts apps/api/src/booth/delivery.test.ts scripts/robot-manual.test.ts scripts/start-local.test.ts apps/api/src/booth/speech-provider.test.ts apps/api/src/booth/speech-http.test.ts apps/api/src/booth/diagnostics.test.ts apps/api/src/booth/wire.test.ts apps/web/src/speech apps/web/src/conversation/selection.test.ts",
    "test:speech:browser": "pnpm build && vitest run apps/api/src/booth/speech-browser.test.ts",
    "test:inventory": "vitest run apps/api/src/booth/inventory.test.ts && pnpm test:conversation:browser",
    "test:interfaces": "vitest run apps/api/src/booth/booth.test.ts -t 正式三接口与任务事实",
    "test:ai": "vitest run apps/api/src/booth/booth.test.ts -t \"OpenAI|双供应商\"",
    "verify:ai": "node --env-file-if-exists=.env --import tsx scripts/verify-ai.ts",
    "test:integration:browser": "pnpm test:conversation:browser",
    "test:order:browser": "pnpm test:conversation:browser",
    "test:screen:browser": "pnpm test:conversation:browser",
    "test:manual:browser": "pnpm test:conversation:browser",
    "test:browser": "pnpm test:conversation:browser",
    "test:booth:browser": "pnpm test:conversation:browser",
    "verify:relay": "node scripts/verify-relay.cjs",
    "serve": "node --env-file-if-exists=.env --import tsx apps/api/src/booth/index.ts --serve-web",
    "manual:gateway": "node --env-file-if-exists=.env --import tsx apps/api/src/booth/index.ts --manual --serve-web",
    "manual:robot": "node --import tsx scripts/robot-manual.ts",
    "test:conversation:browser": "pnpm build && vitest run apps/api/src/booth/conversation-browser.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.2.4",
    "playwright": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
